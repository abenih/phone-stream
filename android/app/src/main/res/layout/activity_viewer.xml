<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:accessibilityLiveRegion="polite" android:text="@string/viewer_status" />
    <FrameLayout android:id="@+id/videoContainer" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:background="#000000">
        <SurfaceView android:id="@+id/video" android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_gravity="center" android:importantForAccessibility="no" />
        <View android:id="@+id/touchLayer" android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/releaseInput"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:minHeight="48dp" android:enabled="false" android:text="@string/release_input" />
        <com.google.android.material.button.MaterialButton android:id="@+id/disconnect"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:minHeight="48dp" android:text="@string/disconnect" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:text="@string/viewer_note" android:textSize="12sp" />
</LinearLayout>
